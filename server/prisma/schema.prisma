generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  PENDING
  URGENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum JobStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum BatchStatus {
  PENDING
  DISBURSED
}

enum TransactionType {
  SALARY
  BONUS
  TAX
}

model Unit {
  id        String      @id @default(uuid())
  name      String      @unique
  code      String      @unique
  personnel Personnel[]
}

model Position {
  id              String        @id @default(uuid())
  title           String
  clearanceLevel  Int           @default(1)
  personnel       Personnel[]
  requisitions    Requisition[]
}

model Personnel {
  id              String                @id @default(uuid())
  fullName        String
  email           String                @unique
  positionId      String
  position        Position              @relation(fields: [positionId], references: [id])
  unitId          String
  unit            Unit                  @relation(fields: [unitId], references: [id])
  status          Status                @default(ACTIVE)
  efficiencyIndex Float?
  transactions    PayrollTransaction[]
  logs            SystemLog[]
  createdAt       DateTime              @default(now())
  deletedAt       DateTime?
}

model Requisition {
  id          String      @id @default(uuid())
  positionId  String
  position    Position    @relation(fields: [positionId], references: [id])
  priority    Priority    @default(MEDIUM)
  status      JobStatus   @default(OPEN)
  postedAt    DateTime    @default(now())
  candidates  Candidate[]
}

model Candidate {
  id            String      @id @default(uuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id])
  fullName      String
  stage         String
  score         Int
}

model PayrollBatch {
  id           String               @id @default(uuid())
  cyclePeriod  String
  totalGross   Decimal              @db.Decimal(15, 2)
  status       BatchStatus          @default(PENDING)
  transactions PayrollTransaction[]
}

model PayrollTransaction {
  id          String          @id @default(uuid())
  batchId     String
  batch       PayrollBatch    @relation(fields: [batchId], references: [id])
  personnelId String
  personnel   Personnel       @relation(fields: [personnelId], references: [id])
  amount      Decimal         @db.Decimal(15, 2)
  type        TransactionType @default(SALARY)
}

model SystemLog {
  id          String    @id @default(uuid())
  eventType   String
  nodeId      String
  payload     Json
  personnelId String?
  personnel   Personnel? @relation(fields: [personnelId], references: [id])
  createdAt   DateTime  @default(now())
}
